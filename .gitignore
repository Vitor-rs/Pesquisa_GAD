# ===================================
# Git Ignore - Pesquisa GAD Project
# ===================================

# ============= Node.js =============
# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Diagnostic reports
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Coverage directory used by tools like istanbul
coverage
*.lcov

# nyc test coverage
.nyc_output

# Dependency directories
node_modules/
jspm_packages/

# TypeScript cache
*.tsbuildinfo

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Optional stylelint cache
.stylelintcache

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# dotenv environment variable files
.env
.env.*
!.env.example

# ============= LaTeX =============
# LaTeX Build Directory
IFMS_TADS_TCC/build/

# LaTeX Auxiliary Files
*.aux
*.bbl
*.bcf
*.blg
*.fdb_latexmk
*.fls
*.lof
*.log
*.lot
*.out
*.run.xml
*.synctex.gz
*.toc
*.dvi
*.ps
*.eps
*.nav
*.snm
*.vrb
*.idx
*.ind
*.ilg
*.brf
*-blx.bib

# LaTeX Backup Files  
*.backup
*~

# LaTeX temporary files (additional)
*.acn
*.acr
*.alg
*.glg
*.glo
*.gls
*.figlist
*.makefile
*.figlist.bak

# ============= IDEs & Editors =============
# VS Code (keep workspace config but ignore user settings)
.vscode/launch.json
.vscode/tasks.json
.vscode/extensions.json
.vscode/*.code-snippets

# Other Editors
*.swp
*.swo
*.vim

# ============= OS Files =============
# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
Desktop.ini

# Linux
*~

# ============= Development =============
# Build outputs
build/
dist/
out/

# Temporary Files
*.tmp
*.temp

# Cache directories
.cache/
.parcel-cache/

# ============= Frameworks =============
# Next.js
.next
.nuxt

# Vite
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# ============= Optional =============
# Uncomment to ignore compiled PDFs (if not tracking final outputs)
# *.pdf
