{
    // Java configuration
    "java.compile.nullAnalysis.mode": "automatic",
    "java.jdt.ls.java.home": "/usr/local/sdkman/candidates/java/21.0.7-ms",
    "java.configuration.runtimes": [
        {
            "name": "JavaSE-21",
            "path": "/usr/local/sdkman/candidates/java/21.0.7-ms",
            "default": true
        }
    ],
    "java.jdt.ls.vmargs": "-XX:+UseParallelGC -XX:GCTimeRatio=4 -XX:AdaptiveSizePolicyWeight=90 -Dsun.zip.disableMemoryMapping=true -Xmx2G -Xms100m",
    "java.import.gradle.enabled": false,
    "java.import.maven.enabled": true,
    "java.configuration.detectJdksAtStart": false,
    
    // LaTeX Workshop configuration for IFMS_TADS_TCC
    "latex-workshop.latex.autoBuild.run": "onSave",
    "latex-workshop.latex.autoClean.run": "onBuilt",
    "latex-workshop.latex.outDir": "%WORKSPACE_FOLDER%/IFMS_TADS_TCC/build",
    "latex-workshop.latex.rootFile.doNotPrompt": true,
    "latex-workshop.latex.rootFile.useSubFile": false,
    "latex-workshop.latex.rootFile.indicator": "\\documentclass[]{}",
    "latex-workshop.latex.build.forceRecipeUsage": true,
    "latex-workshop.latex.autoBuild.cleanAndRetry.enabled": true,
    "latex-workshop.latex.search.rootFiles.include": [
        "**/IFMS_TADS_TCC/src/Monografia_config.tex"
    ],
    "latex-workshop.latex.search.rootFiles.exclude": [
        "**/build/**",
        "**/node_modules/**",
        "**/app/**"
    ],
    "latex-workshop.latex.recipe.default": "latexmk (IFMS_TCC)",
    "latex-workshop.latex.autoBuild.interval": 1000,
    "latex-workshop.latex.clean.subfolder.enabled": true,
    "latex-workshop.latex.clean.fileTypes": [
        "*.aux", "*.bbl", "*.blg", "*.idx", "*.ind", "*.lof", "*.lot", 
        "*.out", "*.toc", "*.acn", "*.acr", "*.alg", "*.glg", "*.glo",
        "*.gls", "*.fls", "*.log", "*.fdb_latexmk", "*.snm", "*.nav", 
        "*.vrb", "*.bcf", "*.run.xml", "*.synctex.gz", "*.brf", "*.ilg"
    ],
    "latex-workshop.view.pdf.ref.viewer": "auto",
    "latex-workshop.view.pdf.external.viewer.command": "code",
    "latex-workshop.view.pdf.external.viewer.args": ["%PDF%"],
    "latex-workshop.synctex.afterBuild.enabled": true,
    "latex-workshop.synctex.path": "synctex",
    
    // LaTeX recipes and tools
    "latex-workshop.latex.recipes": [
        {
            "name": "latexmk (IFMS_TCC)",
            "tools": ["latexmk-ifms"]
        },
        {
            "name": "pdflatex ➞ bibtex ➞ pdflatex × 2 (IFMS_TCC)",
            "tools": ["pdflatex-ifms", "bibtex-ifms", "pdflatex-ifms", "pdflatex-ifms"]
        }
    ],
    "latex-workshop.latex.tools": [
        {
            "name": "latexmk-ifms",
            "command": "latexmk",
            "args": [
                "-cd",
                "-synctex=1",
                "-interaction=nonstopmode",
                "-file-line-error",
                "-pdf",
                "-outdir=../build",
                "%WORKSPACE_FOLDER%/IFMS_TADS_TCC/src/Monografia_config.tex"
            ]
        },
        {
            "name": "pdflatex-ifms",
            "command": "pdflatex",
            "args": [
                "-synctex=1",
                "-interaction=nonstopmode",
                "-file-line-error",
                "-output-directory=%WORKSPACE_FOLDER%/IFMS_TADS_TCC/build",
                "%WORKSPACE_FOLDER%/IFMS_TADS_TCC/src/Monografia_config.tex"
            ]
        },
        {
            "name": "bibtex-ifms",
            "command": "bibtex",
            "args": [
                "%WORKSPACE_FOLDER%/IFMS_TADS_TCC/build/Monografia_config.aux"
            ]
        }
    ]
}
