# Arquivo para variáveis de ambiente sensíveis
# Copie este arquivo para .env e configure suas credenciais

# Banco de dados
POSTGRES_DB=gad_db
POSTGRES_USER=gad_user
POSTGRES_PASSWORD=your_secure_password_here

# PGAdmin
PGADMIN_DEFAULT_EMAIL=admin@gad.com
PGADMIN_DEFAULT_PASSWORD=your_pgadmin_password_here

# Spring Boot
SPRING_PROFILES_ACTIVE=docker
